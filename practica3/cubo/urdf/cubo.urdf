<?xml version="1.0"?>

<robot name="cubo">
    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

    <link name="base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <box size="0.5 0.5 0.5" />
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <box size="0.5 0.5 0.5" />
            </geometry>
        </collision>

		<inertial>
      		<mass value="2.0"/>
      		<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    	</inertial>

    </link>

</robot>