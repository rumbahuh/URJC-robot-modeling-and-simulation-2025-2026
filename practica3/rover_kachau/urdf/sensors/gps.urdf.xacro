<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gps_sensor" params="frame_prefix update_rate parent_link">
    <link name="${frame_prefix}_gps_link"/>
    <joint name="${frame_prefix}_gps_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${frame_prefix}_gps_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${frame_prefix}_gps_link">
      <sensor name="${frame_prefix}_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <topic>/robot/gps/fix</topic>
        <gz_frame_id>${frame_prefix}_gps_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>