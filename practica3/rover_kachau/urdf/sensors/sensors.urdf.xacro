<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rover_kachau)/urdf/sensors/imu_sensor.urdf.xacro"/>
  <xacro:include filename="$(find rover_kachau)/urdf/sensors/camera.urdf.xacro"/>
  <xacro:include filename="$(find rover_kachau)/urdf/sensors/gpu_lidar.urdf.xacro"/>
  <xacro:include filename="$(find rover_kachau)/urdf/sensors/gps.urdf.xacro"/>

  <xacro:imu_sensor prefix="imu" topic="/imu/data" parent_link="base_link"/>

  <xacro:camera_sensor
    frame_prefix="front_cam"
    parent_link="base_link"
    horizontal_fov="1.57"
    video_width="640"
    video_height="480"/>

  <xacro:lidar_sensor frame_prefix="lidar" parent_link="base_link" topic="/lidar/scan"/>

  <xacro:gps_sensor frame_prefix="gps" update_rate="10" parent_link="base_link"/>
</robot>